unfix           1coolB
unfix           2coolB

# ---------- kMC-accelerated relaxation (fix tfmc) ----------
# Runs instead of (not alongside) the NVE integrators above: fix tfmc is
# itself a time-integration fix (LAMMPS docs: "no other fixes of this type,
# such as fix nve, should be used at the same time"). Delta = 0.12 Angstrom
# (the paper's Table I illustration value; 0.10 A is their other validated
# default) is the max displacement (auto-scaled per atom by sqrt(m_min/m_i)
# internally, so lighter Si atoms move further per step than Ar); Temp =
# 298.0 matches the real target temperature this whole simulation runs at.
# 5000 tfMC steps is the tunable "how much accelerated relaxation per ion
# impact" budget -- raise for more relaxation (slower), lower for less
# (faster).
unfix		2
unfix		3

variable	tfmcseed equal floor(random(1,999999,${deposeed}))
variable	tfmcseed equal floor(random(1,999999,2488))
fix		tfmc amobile tfmc 0.12 298.0 ${tfmcseed}
fix		tfmc amobile tfmc 0.12 298.0 228534

