LAMMPS (2 Sep 2026)
KOKKOS mode with Kokkos version 5.2.1 is enabled
  using double precision
  using view layout = legacy
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half
newton          on

variable 	lpcl equal 1100
variable        lpar equal 500
variable 	a loop ${lpcl}
variable 	a loop 1100
variable        b loop ${lpar}
variable        b loop 500

units		metal
atom_style	charge
boundary	p p f
timestep 	0.0005

variable 	lat_a equal 5.43

variable 	x equal 4*${lat_a}
variable 	x equal 4*5.43
variable 	y equal 4*${lat_a}
variable 	y equal 4*5.43
variable 	z equal 8*${lat_a}+12.0
variable 	z equal 8*5.43+12.0
variable 	len_z2 equal 8*${lat_a}
variable 	len_z2 equal 8*5.43

region 		bbox block 0 ${x} 0 ${y} 0 ${z} units box
region 		bbox block 0 21.72 0 ${y} 0 ${z} units box
region 		bbox block 0 21.72 0 21.72 0 ${z} units box
region 		bbox block 0 21.72 0 21.72 0 55.44 units box
create_box 	3 bbox
Created orthogonal box = (0 0 0) to (21.72 21.72 55.44)
  1 by 1 by 1 MPI processor grid

lattice 	diamond ${lat_a}
lattice 	diamond 5.43
Lattice spacing in x,y,z = 5.43 5.43 5.43
region 		lbox block 0 ${x} 0 ${y} 0 ${len_z2} units box
region 		lbox block 0 21.72 0 ${y} 0 ${len_z2} units box
region 		lbox block 0 21.72 0 21.72 0 ${len_z2} units box
region 		lbox block 0 21.72 0 21.72 0 43.44 units box
create_atoms 	1 region lbox
Created 1056 atoms
  using lattice units in orthogonal box = (0 0 0) to (21.72 21.72 55.44)
  create_atoms CPU = 0.010 seconds

variable	M_Si equal 28.0855
variable	M_Ar equal 39.948
variable	M_Cl equal 35.453

mass            1 ${M_Si}
mass            1 28.0855
mass            2 ${M_Ar}
mass            2 39.948
mass		3 ${M_Cl}
mass		3 35.453

region          anchor block INF INF INF INF 0.0 2.72 units box
region          insert block 0.0 ${x} 0.0 ${y} $((v_z-1.5)) $((v_z-1.5)) units box
region          insert block 0.0 21.72 0.0 ${y} $((v_z-1.5)) $((v_z-1.5)) units box
region          insert block 0.0 21.72 0.0 21.72 $((v_z-1.5)) $((v_z-1.5)) units box
region          insert block 0.0 21.72 0.0 21.72 53.939999999999997726 $((v_z-1.5)) units box
region          insert block 0.0 21.72 0.0 21.72 53.939999999999997726 53.939999999999997726 units box
region		del block INF INF INF INF $((v_z-3)) ${z} units box
region		del block INF INF INF INF 52.439999999999997726 ${z} units box
region		del block INF INF INF INF 52.439999999999997726 55.44 units box

group 		anchor region anchor
96 atoms in group anchor
group		insert region insert
0 atoms in group insert
group 		mobile subtract all anchor
960 atoms in group mobile
group		amobile union mobile insert
960 atoms in group amobile

variable 	energ equal 80
variable 	angl equal 0

variable 	vel equal sqrt(2*${energ}*6.02214129*1.0e+7/${M_Ar}/6242)
variable 	vel equal sqrt(2*80*6.02214129*1.0e+7/${M_Ar}/6242)
variable 	vel equal sqrt(2*80*6.02214129*1.0e+7/39.948/6242)
variable 	velz equal cos(${angl}*PI/180)*${vel}
variable 	velz equal cos(0*PI/180)*${vel}
variable 	velz equal cos(0*PI/180)*196.573992684911
variable 	vely equal sin(${angl}*PI/180)*${vel}
variable 	vely equal sin(0*PI/180)*${vel}
variable 	vely equal sin(0*PI/180)*196.573992684911

velocity	mobile create 298.0 459087


# ---------- MACE POTENTIAL (CPU-compatible: no cuequivariance, built without --format=mliap's forced cueq conversion) ----------
pair_style      mliap unified ../Sputtering_MACE/MLIAP/mace-medium-density-agnesi-stress.model-mliap_lammps_cpu.pt 0
pair_coeff      * * Si Ar Cl
# ------------------------------------


neighbor 	1.0 bin
neigh_modify   	every 10 delay 0 check no

variable	nall     equal count(all)
variable	nfixed   equal count(anchor)
variable	nmobile  equal count(mobile)
variable 	ninject  equal count(insert)
thermo      	100
compute     	mtemp amobile temp
thermo_style    custom step atoms v_nmobile v_ninject temp etotal
compute_modify  mtemp dynamic/dof yes
thermo_modify   temp mtemp
WARNING: Temperature for thermo pressure is not for group all (src/thermo.cpp:593)
thermo_modify	lost warn

dump            myDump all custom 400 dump_cpu.lammpstrj id type x y z vx vy vz

restart         4000 restart_cpu.1 restart_cpu.2

variable    	c equal 0.0

molecule        cl2 molecule.cl2
Read molecule template cl2:
# Cl2 molecule template
  1 molecules
  0 fragments
  0 bodies
  2 atoms with max type 3
  0 bonds with max type 0
  0 angles with max type 0
  0 dihedrals with max type 0
  0 impropers with max type 0

label		loopcl

variable    	c equal ${c}+1
variable    	c equal 0+1
variable    	deposeed equal floor(random(1,3245,${c}))
variable    	deposeed equal floor(random(1,3245,1))

variable	velxcl equal normal(0,sqrt(2*${M_Cl}*8.617333262e-5*298.0),${deposeed})
variable	velxcl equal normal(0,sqrt(2*35.453*8.617333262e-5*298.0),${deposeed})
variable	velxcl equal normal(0,sqrt(2*35.453*8.617333262e-5*298.0),260)
variable        velycl equal normal(0,sqrt(2*${M_Cl}*8.617333262e-5*298.0),${deposeed})
variable        velycl equal normal(0,sqrt(2*35.453*8.617333262e-5*298.0),${deposeed})
variable        velycl equal normal(0,sqrt(2*35.453*8.617333262e-5*298.0),579)
variable        velzcl equal -abs(normal(0,sqrt(2*${M_Cl}*8.617333262e-5*298.0),${deposeed}))
variable        velzcl equal -abs(normal(0,sqrt(2*35.453*8.617333262e-5*298.0),${deposeed}))
variable        velzcl equal -abs(normal(0,sqrt(2*35.453*8.617333262e-5*298.0),2145))

fix		depocl insert deposit 1 0 1000 ${deposeed} region insert mol cl2 vx ${velxcl} ${velxcl} vy ${velycl} ${velycl} vz ${velzcl} ${velzcl} units box
fix		depocl insert deposit 1 0 1000 1063 region insert mol cl2 vx ${velxcl} ${velxcl} vy ${velycl} ${velycl} vz ${velzcl} ${velzcl} units box
fix		depocl insert deposit 1 0 1000 1063 region insert mol cl2 vx -0.766793886224478 ${velxcl} vy ${velycl} ${velycl} vz ${velzcl} ${velzcl} units box
fix		depocl insert deposit 1 0 1000 1063 region insert mol cl2 vx -0.766793886224478 0.78717956736135 vy ${velycl} ${velycl} vz ${velzcl} ${velzcl} units box
fix		depocl insert deposit 1 0 1000 1063 region insert mol cl2 vx -0.766793886224478 0.78717956736135 vy -1.56715916468047 ${velycl} vz ${velzcl} ${velzcl} units box
fix		depocl insert deposit 1 0 1000 1063 region insert mol cl2 vx -0.766793886224478 0.78717956736135 vy -1.56715916468047 -0.757254471047808 vz ${velzcl} ${velzcl} units box
fix		depocl insert deposit 1 0 1000 1063 region insert mol cl2 vx -0.766793886224478 0.78717956736135 vy -1.56715916468047 -0.757254471047808 vz -2.09766620153626 ${velzcl} units box
fix		depocl insert deposit 1 0 1000 1063 region insert mol cl2 vx -0.766793886224478 0.78717956736135 vy -1.56715916468047 -0.757254471047808 vz -2.09766620153626 -0.177996418469188 units box

fix     	2 mobile nve
fix             3 insert nve

run		2000

